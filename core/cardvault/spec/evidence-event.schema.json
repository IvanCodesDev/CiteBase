{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardvault.dev/spec/evidence-event/v0.1.json",
  "title": "CardVault EvidenceEvent",
  "description": "执行证据回流协议（v0.1 草案）：任何 Agent 系统在任务结束后投递的结构化成败记录。事件本身作为一种 Source（adapter: evidence）落库——经验知识的出处就是那次真实运行。自由文本字段限长并经注入扫描；回流产物不豁免两道闸。",
  "type": "object",
  "required": ["event_id", "ts", "system", "outcome"],
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^evt-[a-z0-9]+([-.][a-z0-9]+)*$",
      "description": "全局唯一事件 id，建议含日期，如 evt-2026-08-14-run-0392"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "system": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "maxLength": 50 }
      },
      "description": "投递方系统标识（如 openmathmodel-evals / langgraph-app）"
    },
    "task_ref": {
      "type": "string",
      "maxLength": 200,
      "description": "外部任务的不透明标识；不得携带敏感内容或任务正文"
    },
    "cards_consulted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["card_id"],
        "additionalProperties": false,
        "properties": {
          "card_id": {
            "type": "string",
            "pattern": "^(?:[a-z0-9-]+::)?card-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "claims_used": {
            "type": "array",
            "items": { "type": "string", "pattern": "^c[0-9]+$" }
          }
        }
      },
      "description": "本次任务引用的卡与论断；贡献度度量的数据基础，SDK/MCP 层自动记录"
    },
    "outcome": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["success", "failure", "partial"] },
        "metrics": {
          "type": "object",
          "description": "任务级指标（如误差、耗时）；键值自定义，仅数值与短字符串",
          "additionalProperties": { "type": ["number", "string", "boolean"] }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "maxLength": 100,
          "description": "失败类别（回流编译器按此聚类；≥2 次同类才提卡）"
        },
        "summary": {
          "type": "string",
          "maxLength": 2000,
          "description": "现象描述；限长 + 注入扫描"
        },
        "root_cause_hypothesis": {
          "type": "string",
          "maxLength": 2000,
          "description": "根因假设；限长 + 注入扫描"
        }
      },
      "description": "outcome.status 为 failure/partial 时建议提供"
    }
  }
}
