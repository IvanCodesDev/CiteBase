{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citebase.dev/spec/pack/v0.1.json",
  "title": "Citebase Ontology Pack",
  "description": "本体包声明文件 pack.yaml 的契约（v0.1 草案）。Pack 是纯声明（YAML），不含可执行代码；领域语义全部住在 Pack 里，内核零领域词（L-CORE-1）。",
  "type": "object",
  "required": ["name", "version", "card_kinds"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 50,
      "description": "包名，如 generic / code / research / mathmodel"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "semver；kind 或谓词的破坏性变更须主版本 +1 并附迁移说明"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "card_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "body_sections"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "not": { "const": "contradiction" },
            "description": "卡类名；contradiction 为内核保留值，Pack 不得声明"
          },
          "body_sections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": { "type": "string", "minLength": 1, "maxLength": 30 },
            "description": "该卡类正文的固定分节（如：是什么 / 何时用 / 怎么用 / 边界与陷阱 / 关联）"
          }
        }
      }
    },
    "link_predicates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "maxLength": 40
      },
      "uniqueItems": true,
      "description": "受控谓词表；链接谓词必须在启用 Pack 的并集内（L-LINK-1）"
    },
    "tag_vocab": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1, "maxLength": 40 },
        "uniqueItems": true
      },
      "description": "命名标签词表：维度名 → 受控取值，如 task_types: [预测, 优化, 评价]"
    }
  }
}
